ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres_user:password@localhost:5432/talentdb

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

STORAGE_BACKEND=local
AZURE_STORAGE_SAS_URL=<replace-with-your-azure-storage-sas-url>
LOCAL_STORAGE_ROOT=./storage/resumes

# Local extraction (Phase 4) via Ollama -- no GPU, no HF_TOKEN needed.
# Run `ollama serve` and `ollama pull hf.co/QuantFactory/Qwen2-1.5B-Instruct-GGUF:Q4_K_M`
# before starting the backend/worker.
OLLAMA_BASE_URL=http://localhost:11434
HF_INFERENCE_PROVIDER=ollama
HF_EXTRACTION_MODEL=hf.co/QuantFactory/Qwen2-1.5B-Instruct-GGUF:Q4_K_M
HF_SKILLS_MODEL=hf.co/QuantFactory/Qwen2-1.5B-Instruct-GGUF:Q4_K_M
HF_SKILLS_PROVIDER=ollama

# Only needed if you switch HF_INFERENCE_PROVIDER back to a paid
# provider (e.g. cerebras, featherless-ai).
# HF_TOKEN=<replace-with-your-huggingface-token>

# Redis / Celery (extraction queue)
REDIS_URL=redis://localhost:6379/0