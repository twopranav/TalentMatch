ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres:user@password:port/dbname

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

STORAGE_BACKEND=azure # azure or local
AZURE_STORAGE_SAS_URL=<azure sas url>
LOCAL_STORAGE_ROOT=./storage/resumes

# Only needed if a task's llm_configs row uses provider="huggingface".
HF_TOKEN=<huggingface token>

REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=<groq api key>

EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# "redis" (shared across workers), "memory", or "off"
RATE_LIMIT_BACKEND=redis

# --- Bulk uploads / extraction limits (all optional; these are the defaults) ---
# BULK_CHUNK_SIZE=16               # files read into memory at once during a bulk upload
# BULK_UPLOAD_CONCURRENCY=8        # parallel uploads to blob storage per chunk
# EXTRACTION_SOFT_TIME_LIMIT=300   # seconds before an extraction task is marked FAILED
# EXTRACTION_HARD_TIME_LIMIT=330   # seconds before the worker kills it (prefork pool only)

# --- Logging ---
# auto = readable text when ENV=development, JSON when ENV=production.
# Force with "json" or "text".
LOG_FORMAT=auto
LOG_LEVEL=INFO
