ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://postgres_user:password@localhost:5432/talentdb

JWT_SECRET_KEY=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

CORS_ORIGINS=["http://localhost:5173"]

STORAGE_BACKEND=local
AZURE_STORAGE_SAS_URL=<replace-with-your-azure-storage-sas-url>
LOCAL_STORAGE_ROOT=./storage/resumes

# Extraction (resume_skills / jd_skills) now picks its provider+model
# from the llm_configs DB table, editable via the admin API/UI -- see
# PUT /api/admin/llm-config/{task}. Nothing here selects a model
# anymore; these are only credentials, only needed for the provider(s)
# an admin actually points a task at.

# HF_TOKEN=<replace-with-your-huggingface-token>
# OPENAI_API_KEY=<replace-with-your-openai-api-key>

# Redis / Celery (extraction queue)
REDIS_URL=redis://localhost:6379/0
GROQ_API_KEY=your-key-here